# .envrc for the spectacle fleet config
# Loaded by direnv on `cd`. See modules/aspects/dev/direnv.nix.

# ── Sops: edit secrets under sudo, decrypts via TPM ───────────────
# The TPM identity is at the standard sops-nix path (root-only 600).
# sudo preserves this env var via the `env_keep` rule in sops-cli aspect.
export SOPS_AGE_KEY_FILE="/var/lib/sops/tpm-identity.txt"

# Don't search up from CWD — point at the config in this repo.
export SOPS_CONFIG="$PWD/secrets/.sops.yaml"

# ── Editor: micro (safe for running as root under `sudo sops`) ────
# sops uses $SOPS_EDITOR first, then falls back to $EDITOR.
# Setting $SOPS_EDITOR specifically avoids overriding the user's
# general $EDITOR preference for other sudo operations.
export SOPS_EDITOR="${SOPS_EDITOR:-micro}"
