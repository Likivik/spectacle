# VM disk images
*.qcow2
# serial log the serenity smoke app writes next to the image (checks.nix)
serenity-smoke.log
poweredge-smoke.log
# Build outputs (nix build, nixos-rebuild)
result
# ISO images from fleet-installer build
*.iso
# Node.js packages
node_modules
# Bun lockfile
bun.lock
# niri config backup (nh creates this during switch)
config.kdl.backup*

# DMS auto-generated files
modules/users/*/dotfiles/DankMaterialShell/.changelog*
modules/users/*/dotfiles/DankMaterialShell/.firstlaunch

# opencode-agent-monitor logs
.opencode/agent-monitor.log*
result-bin
worktrees/

# Python bytecode
__pycache__/
*.pyc

# Venice AI API key
.env

# --- Secrets and local tooling state ---------------------------------------
# The repository is public, so a secret that lands in a commit is public the
# moment it is pushed, and stays public in history and in every fork even after
# it is deleted. These patterns are cheap insurance against the next one.
#
# Note: .gitignore does NOT untrack anything already committed, and it does not
# protect a file that was committed before the rule existed. A rule is only a
# guard against the future; a leaked value needs rotation, not a rule.
*.key
*.age
*.pem
age-key*
sops-age*

# direnv / Nix dev-shell state
.direnv/
# pytest state
.pytest_cache/
