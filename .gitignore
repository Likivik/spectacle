# VM disk images
*.qcow2
# Build outputs (nix build, nixos-rebuild)
result
# ISO images from fleet-installer build
*.iso
# Node.js packages
node_modules
# Bun lockfile
bun.lock
# niri config backup (nh creates this during switch)
config.kdl.backup*

# DMS auto-generated files
modules/users/*/dotfiles/DankMaterialShell/.changelog*
modules/users/*/dotfiles/DankMaterialShell/.firstlaunch

# opencode-agent-monitor logs
.opencode/agent-monitor.log*
