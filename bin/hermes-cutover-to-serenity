#!/usr/bin/env bash
# Stage B cutover: move the Hermes agent's messaging pollers erebus -> serenity.
#
# TIMING: ~35-45 min end to end (the delta backup and the rsync top-up dominate).
# The bot is only offline from step 3 to step 4 — about 2-4 minutes.
#
# WHY STEP 3b EXISTS (the graph needs its own sync)
#   FalkorDB lives outside ~/.hermes, so the zip never carries it, and it is a
#   live store: the stage-A dump was 14 nodes / 41 edges behind within the hour
#   of being copied. It is copied between stopping erebus's poller and starting
#   serenity's — the only window where nothing writes to it.
#
# WHY THIS IS A SEPARATE, MANUAL STEP
#   Two gateways polling the same Telegram token do not conflict loudly — they
#   split updates between them. So the order is strict: stop the poller on
#   erebus FIRST, then start the one on serenity.
#
# WHY THE ZIP ALONE IS NOT ENOUGH (verified 2026-10-05)
#   `hermes backup` silently skips files it cannot store. Measured gaps against
#   the live home: skills 235/657 files (53 SKILL.md missing!), plugins 277/314,
#   profiles 139/4106, mcp-servers 132/13018. Cause: 393 files carry pre-1980
#   mtimes ("ZIP does not support timestamps before 1980"), plus deliberate
#   exclusions. History loss in state.db is acceptable; skills/profiles/config
#   are procedure, so we top those up with rsync, which has no such limit.
#
# WHY THE UNMASK IN STEP 4 IS MANDATORY
#   wantedBy = [ ] parks a unit at boot but does NOT survive a nixos-rebuild
#   activation: switch-to-configuration restarts post-activation units that
#   consume changed secrets. That is exactly how serenity's gateway started and
#   polled during stage A (Telegram logged a getUpdates conflict and the
#   serenity side backed off). While parked it is therefore MASKED at user level
#   (~/.config/systemd/user/<unit> -> /dev/null), which outranks the unit file
#   nixos writes to /etc/systemd/user/ and so survives switches.
#
# PRECONDITIONS (checked below)
#   1. serenity's host config is deployed (hermes user exists, units installed).
#   2. serenity's gateway units are installed, PARKED and MASKED.
#   3. Your shell is NOT the gateway's own session — this stops it.

set -euo pipefail

SERENITY=likivik@serenity
H=/var/lib/hermes/.hermes
STAMP=$(date +%Y%m%d-%H%M%S)
WORK=/tmp/hermes-cutover-$STAMP
# Small, procedure-bearing state. Deliberately excluded: state.db (huge, comes
# via the zip), cache/, lazy-packages/.
TOPUP="skills plugins mcp-servers profiles cron memories webui-state sessions config.yaml auth.json"

say() { printf '\n=== %s ===\n' "$*"; }
fail() { printf '\nFAILED: %s\n' "$*" >&2; exit 1; }
ctl() {  # systemctl --user for the hermes account; arg 1 = ssh|local
  local where="$1"; shift
  if [ "$where" = ssh ]; then
    ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n -u hermes XDG_RUNTIME_DIR=/run/user/\$(id -u hermes) systemctl --user $*"
  else
    sudo -n -u hermes XDG_RUNTIME_DIR=/run/user/$(id -u hermes) systemctl --user "$@"
  fi
}

say "0. preflight"
# Must run AS THE HERMES USER: the home is drwx------ hermes, so as anyone else
# both `hermes backup` and the local rsync reads fail with permission denied.
# Hence:  sudo -u hermes bash /Storage/Git/spectacle/bin/hermes-cutover-to-serenity
[ "$(id -un)" = hermes ] || fail "run me as the hermes user: sudo -u hermes bash $0"
command -v hermes >/dev/null || fail "no hermes CLI here"
ssh -o ConnectTimeout=10 "$SERENITY" true || fail "serenity unreachable"
ssh -o ConnectTimeout=10 "$SERENITY" "test -d $H" || fail "serenity has no $H — deploy stage A first"
echo "  erebus pollers:   $(ctl local is-active hermes-gateway 2>/dev/null || echo unknown)"
echo "  serenity pollers: $(ctl ssh is-enabled hermes-gateway 2>/dev/null || echo unknown) (masked = expected while parked)"

say "1. final delta backup on erebus (live — pollers still up here)"
mkdir -p "$WORK"
hermes backup -o "$WORK/hermes-cutover.zip"
ls -lh "$WORK/hermes-cutover.zip"

say "2. transfer + import on serenity (its pollers are parked, so this is safe)"
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n chown hermes:hermes $WORK/hermes-cutover.zip" 2>/dev/null || true
scp -q "$WORK/hermes-cutover.zip" "$SERENITY:$WORK/hermes-cutover.zip"
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n chown hermes:hermes $WORK/hermes-cutover.zip; sudo -n -u hermes HERMES_HOME=$H hermes import --force $WORK/hermes-cutover.zip 2>&1 | tail -4"

say "2b. top up what the zip silently skipped (see header)"
cd "$H"
# Ownership first: aspect activation creates some of these as root, which made
# rsync fail partway (mkdir Permission denied) and left profiles/mcp-servers empty.
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n chown -R hermes:hermes $H"
rsync -a --ignore-missing-args --rsync-path="sudo -n -u hermes rsync" \
  $TOPUP "$SERENITY:$H/"
echo "--- verify the gaps are closed (counts must match) ---"
for d in skills plugins mcp-servers profiles cron memories sessions webui-state; do
  printf '  %-14s erebus=%-7s serenity=%s\n' "$d" \
    "$(find "$d" -type f 2>/dev/null | wc -l)" \
    "$(ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n -u hermes find $H/$d -type f 2>/dev/null | wc -l")"
done

say "2c. agent health on serenity (before any token moves)"
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n -u hermes HERMES_HOME=$H hermes status 2>&1 | head -20"

say "2d. the knowledge graph (FalkorDB lives outside ~/.hermes — the zip never carries it)"
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n podman exec falkordb redis-cli GRAPH.LIST 2>&1 | head -5"

say "3. stop the pollers on erebus (the bot is offline from here)"
ctl local stop hermes-gateway hermes-gateway-salem
ctl local is-active hermes-gateway || true

say "3b. final knowledge-graph copy (safe only after erebus stops writing)"
# FalkorDB is NOT in ~/.hermes: the zip never carries it, so it gets its own
# sync — and it must land between the two poller transitions. The graph is a
# live store, and a copy taken while the source is still writing loses whatever
# it writes afterwards (the stage-A dump was already 14 nodes / 41 edges behind
# by the time it was checked). The destination's container is stopped first
# because its shutdown-save would otherwise clobber the fresh dump with an
# empty one.
sudo -n podman exec falkordb redis-cli SAVE
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n systemctl stop podman-falkordb"
sudo -n tar -C /var/lib/hermes/falkordb-data -cf - . \
  | ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n tar -C /var/lib/hermes/falkordb-data -xf -"
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n systemctl start podman-falkordb"
sleep 15
echo "--- graphs must match (both should list the same names) ---"
printf '  serenity: %s\n' "$(ssh -o ConnectTimeout=10 "$SERENITY" 'sudo -n podman exec falkordb redis-cli GRAPH.LIST' | grep -v '^$' | paste -sd, -)"
printf '  erebus:   %s\n' "$(sudo -n podman exec falkordb redis-cli GRAPH.LIST | grep -v '^$' | paste -sd, -)"

say "4. start the pollers on serenity (unmask is mandatory — see header)"
ctl ssh unmask hermes-gateway hermes-gateway-salem
ctl ssh start hermes-gateway hermes-gateway-salem
sleep 8
ctl ssh is-active hermes-gateway hermes-gateway-salem || true

say "5. verify — a Telegram round-trip, not just 'active'"
ssh -o ConnectTimeout=10 "$SERENITY" "sudo -n -u hermes XDG_RUNTIME_DIR=/run/user/\$(id -u hermes) journalctl --user -u hermes-gateway -n 25 --no-pager 2>/dev/null | tail -18" || true

cat <<EOF

=== DONE — verify by talking to the bot, then make it declarative ===

Rollback (seconds):
  # stop + re-mask serenity's pollers FIRST, or a rerun double-polls
  ssh $SERENITY 'sudo -n -u hermes XDG_RUNTIME_DIR=/run/user/\$(id -u hermes) systemctl --user stop hermes-gateway hermes-gateway-salem; sudo -n -u hermes XDG_RUNTIME_DIR=/run/user/\$(id -u hermes) systemctl --user mask hermes-gateway hermes-gateway-salem'
  # then hand the bot back to erebus
  sudo -n -u hermes XDG_RUNTIME_DIR=/run/user/\$(id -u hermes) systemctl --user start hermes-gateway hermes-gateway-salem

Then, so a reboot cannot resurrect the old poller:
  serenity.nix : remove the two wantedBy = mkForce [ ] overrides
  erebus.nix   : add them, and drop searxng/sillytavern/beszel/fishaudio includes
EOF
