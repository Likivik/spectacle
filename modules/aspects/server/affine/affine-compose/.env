# AFFiNE Self-Hosted — Tailscale-only deployment on erebus
# Access via: http://100.80.80.98:3010

# Revision: stable, beta, or canary
AFFINE_REVISION=stable

# Server port
PORT=3010

# Storage locations (inside container, mounted as volumes)
DB_DATA_LOCATION=/var/lib/affine/postgres/pgdata
UPLOAD_LOCATION=/var/lib/affine/storage
CONFIG_LOCATION=/var/lib/affine/config

# Database credentials (DUMMY — replace in production)
DB_USERNAME=affine
DB_PASSWORD=changeme_affine_db_2026
DB_DATABASE=affine

