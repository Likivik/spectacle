# =============================================================================
# AppFlowy Cloud — Tailscale-only deployment on erebus
# =============================================================================
# Access via: http://100.80.80.98 (Tailscale)
# All secrets below are DUMMIES — replace with real values before production use.

# Tailscale-only: use the Tailscale IP or hostname of this host.
# The Android app and desktop clients will connect to this address.
FQDN=localhost

# HTTP only — Tailscale tunnel provides encryption at the network layer.
SCHEME=http
WS_SCHEME=ws

APPFLOWY_BASE_URL=${SCHEME}://${FQDN}
APPFLOWY_WEBSOCKET_BASE_URL=${WS_SCHEME}://${FQDN}/ws/v2

# =============================================================================
# DATABASE & CACHE
# =============================================================================

POSTGRES_HOST=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme_postgres_2026
POSTGRES_PORT=5432
POSTGRES_DB=postgres

REDIS_HOST=redis
REDIS_PORT=6379

# =============================================================================
# INFRASTRUCTURE — MinIO (S3-compatible object storage)
# =============================================================================

MINIO_HOST=minio
MINIO_PORT=9000

# Dummy MinIO credentials — replace in production
AWS_ACCESS_KEY=changeme_minio_user
AWS_SECRET=changeme_minio_pass

# =============================================================================
# APPFLOWY SERVICES
# =============================================================================

APPFLOWY_GOTRUE_BASE_URL=http://gotrue:9999
APPFLOWY_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
APPFLOWY_ACCESS_CONTROL=true
APPFLOWY_WEBSOCKET_MAILBOX_SIZE=6000
APPFLOWY_DATABASE_MAX_CONNECTIONS=40
APPFLOWY_REDIS_URI=redis://${REDIS_HOST}:${REDIS_PORT}

GOTRUE_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}?search_path=auth

# =============================================================================
# GOTRUE — Authentication
# =============================================================================

# Dummy admin credentials — replace in production
GOTRUE_ADMIN_EMAIL=admin@erebus.tailnet
GOTRUE_ADMIN_PASSWORD=changeme_admin_2026

# Dummy JWT secret — replace in production
GOTRUE_JWT_SECRET=changeme_jwt_secret_2026
GOTRUE_JWT_EXP=604800

API_EXTERNAL_URL=${APPFLOWY_BASE_URL}/gotrue

# Tailscale-only: autoconfirm signup, no email verification needed.
# To create new accounts: use the admin panel or GoTrue API directly.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_RATE_LIMIT_EMAIL_SENT=100
GOTRUE_MAILER_TEMPLATES_MAGIC_LINK=

# No SMTP configured — Tailscale-only, no email needed.
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=0
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=

# AppFlowy Cloud mailer — also unused without SMTP
APPFLOWY_MAILER_SMTP_HOST=
APPFLOWY_MAILER_SMTP_PORT=0
APPFLOWY_MAILER_SMTP_USERNAME=
APPFLOWY_MAILER_SMTP_EMAIL=
APPFLOWY_MAILER_SMTP_PASSWORD=
APPFLOWY_MAILER_SMTP_TLS_KIND=wrapper

# =============================================================================
# OAUTH PROVIDERS — all disabled (Tailscale-only, no need)
# =============================================================================

GOTRUE_EXTERNAL_GOOGLE_ENABLED=false
GOTRUE_EXTERNAL_GOOGLE_CLIENT_ID=
GOTRUE_EXTERNAL_GOOGLE_SECRET=
GOTRUE_EXTERNAL_GOOGLE_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_EXTERNAL_GITHUB_ENABLED=false
GOTRUE_EXTERNAL_GITHUB_CLIENT_ID=
GOTRUE_EXTERNAL_GITHUB_SECRET=
GOTRUE_EXTERNAL_GITHUB_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_EXTERNAL_DISCORD_ENABLED=false
GOTRUE_EXTERNAL_DISCORD_CLIENT_ID=
GOTRUE_EXTERNAL_DISCORD_SECRET=
GOTRUE_EXTERNAL_DISCORD_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_EXTERNAL_APPLE_ENABLED=false
GOTRUE_EXTERNAL_APPLE_CLIENT_ID=
GOTRUE_EXTERNAL_APPLE_SECRET=
GOTRUE_EXTERNAL_APPLE_REDIRECT_URI=${API_EXTERNAL_URL}/callback

GOTRUE_SAML_ENABLED=false
GOTRUE_SAML_PRIVATE_KEY=

# =============================================================================
# FILE STORAGE — MinIO
# =============================================================================

APPFLOWY_S3_USE_MINIO=true
APPFLOWY_S3_CREATE_BUCKET=true
APPFLOWY_S3_MINIO_URL=http://${MINIO_HOST}:${MINIO_PORT}
APPFLOWY_S3_ACCESS_KEY=${AWS_ACCESS_KEY}
APPFLOWY_S3_SECRET_KEY=${AWS_SECRET}
APPFLOWY_S3_BUCKET=appflowy
APPFLOWY_S3_PRESIGNED_URL_ENDPOINT=${APPFLOWY_BASE_URL}/minio-api

# =============================================================================
# AI FEATURES — disabled (no OpenAI key, no cost)
# =============================================================================

AI_OPENAI_API_KEY=
AI_OPENAI_API_SUMMARY_MODEL=
AI_AZURE_OPENAI_API_KEY=
AI_AZURE_OPENAI_API_BASE=
AI_AZURE_OPENAI_API_VERSION=

AI_SERVER_PORT=5001
AI_SERVER_HOST=ai
AI_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
AI_REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
AI_APPFLOWY_BUCKET_NAME=${APPFLOWY_S3_BUCKET}
AI_APPFLOWY_HOST=${APPFLOWY_BASE_URL}
AI_MINIO_URL=http://${MINIO_HOST}:${MINIO_PORT}

APPFLOWY_EMBEDDING_CHUNK_SIZE=2000
APPFLOWY_EMBEDDING_CHUNK_OVERLAP=200

# =============================================================================
# WORKER SERVICES
# =============================================================================

APPFLOWY_INDEXER_ENABLED=true
APPFLOWY_INDEXER_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
APPFLOWY_INDEXER_REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
APPFLOWY_INDEXER_EMBEDDING_BUFFER_SIZE=5000

APPFLOWY_COLLABORATE_MULTI_THREAD=false
APPFLOWY_COLLABORATE_REMOVE_BATCH_SIZE=100

APPFLOWY_WORKER_REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}
APPFLOWY_WORKER_DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}
APPFLOWY_WORKER_DATABASE_NAME=${POSTGRES_DB}

# =============================================================================
# SEARCH SERVICE
# =============================================================================

APPFLOWY_SEARCH_SERVICE_URL=${APPFLOWY_SEARCH_SERVICE_URL:-http://appflowy_search:4002}
APPFLOWY_SEARCH_REQUEST_TIMEOUT_SECS=10
AI_ENABLED=true

# Whitelist-based signup: set to true + GOTRUE_DISABLE_SIGNUP=false to gate
# who can register via admin invitations only.
SIGNUP_WHITELIST_ENABLED=false
GUEST_INVITES_REQUIRE_ADMIN_APPROVAL=false

# =============================================================================
# REAL TIME TRANSCRIPTION — disabled
# =============================================================================

ASSEMBLYAI_API_KEY=
ASSEMBLYAI_API_BASE=https://api.assemblyai.com/v2
ASSEMBLYAI_STREAMING_API_BASE=https://streaming.assemblyai.com/v3

# =============================================================================
# WEB FRONTEND
# =============================================================================

APPFLOWY_WEB_URL=${APPFLOWY_BASE_URL}

# =============================================================================
# PGADMIN — disabled (not in compose, admin_frontend used instead)
# =============================================================================

PGADMIN_DEFAULT_EMAIL=admin@erebus.tailnet
PGADMIN_DEFAULT_PASSWORD=changeme_pgadmin_2026

# =============================================================================
# WEB UI & ADMIN — exposed on separate ports (not routed through nginx)
# =============================================================================

ADMIN_FRONTEND_PORT=3000
APPFLOWY_WEB_PORT=3001

# =============================================================================
# NGINX
# =============================================================================

# Standard port 80 — no port needed in URLs.
NGINX_PORT=80
NGINX_TLS_PORT=443

# =============================================================================
# MISC
# =============================================================================

RUST_LOG=info
CLOUDFLARE_TUNNEL_TOKEN=
AI_TEST_ENABLED=false
