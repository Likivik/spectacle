# EVC Team Relay - PowerEdge Configuration
# Secrets managed by sops-nix

# Domain
DOMAIN_BASE=filepath.ru
ACME_EMAIL=likivik@gmail.com

# PostgreSQL
POSTGRES_USER=relay
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=relay
DATABASE_URL=postgresql+psycopg://relay:CHANGE_ME@postgres:5432/relay

# MinIO
MINIO_ROOT_USER=relay
MINIO_ROOT_PASSWORD=CHANGE_ME

# Authentication
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_32
BOOTSTRAP_ADMIN_EMAIL=likivik@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# Relay server
RELAY_PUBLIC_URL=wss://obsidian.filepath.ru/doc/ws
SERVER_NAME=EVC Team Relay

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Backup
BACKUP_RETENTION=7
BACKUP_HOUR=2
BACKUP_RUN_ON_STARTUP=true

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Web Publishing
WEB_PUBLISH_DOMAIN=docs.obsidian.filepath.ru

# Email (disabled)
EMAIL_ENABLED=false
