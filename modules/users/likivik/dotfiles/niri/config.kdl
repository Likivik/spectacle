binds {
    // Launcher
    Super+Super_L { spawn-sh "noctalia msg panel-toggle launcher"; }
    // Control Center (overrides niri default Super+S screenshot)
    Super+S { spawn-sh "noctalia msg panel-toggle control-center"; }
    // Settings
    Super+Comma { spawn-sh "noctalia msg settings-toggle"; }
    // Lock screen
    Super+Escape { spawn-sh "noctalia msg screen-lock"; }
    // Theme toggle
    Super+T { spawn-sh "noctalia msg theme-mode-toggle"; }
    // Clipboard history
    Super+V { spawn-sh "noctalia msg panel-toggle clipboard"; }
    // Dock toggle
    Super+D { spawn-sh "noctalia msg dock-toggle"; }
    // Do Not Disturb
    Super+N { spawn-sh "noctalia msg notification-dnd-toggle"; }
    // Session menu
    Super+X { spawn-sh "noctalia msg panel-toggle session"; }

    // Media keys
    XF86AudioRaiseVolume { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown { spawn "noctalia" "msg" "brightness-down"; }
}

// Autostart Noctalia
spawn-at-startup "noctalia"
