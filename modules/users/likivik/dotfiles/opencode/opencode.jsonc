{
  "$schema": "https://opencode.ai/config.json",
  "model": "",
  "autoshare": false,
  "autoupdate": false,
  "plugin": [
    "opencode-snip@latest",
    "@tarquinen/opencode-dcp@latest",
    "@simonwjackson/opencode-direnv",
    "cc-safety-net",
    "./plugins/mnemosyne-bridge.ts",
    "opencode-throughput@latest",
    "@ramtinj95/opencode-tokenscope@latest",
    "opencode-token-monitor@latest"
  ],
  "permission": {
    "edit": "ask",
    "codesearch": "allow",
    "websearch": "allow"
  },
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "mnemosyne": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix", "shell",
        "nixpkgs#python3",
        "nixpkgs#python313Packages.pipx",
        "-c",
        "pipx", "run", "--spec", "mnemosyne-memory[mcp]", "--with", "mnemosyne-hermes", "mnemosyne", "mcp"
      ]
    },
    "nixos": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "github:utensils/mcp-nixos",
        "-c",
        "mcp-nixos"
      ]
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
