{
  "$schema": "https://opencode.ai/config.json",
  "model": "",
  "autoshare": false,
  "autoupdate": false,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "mcp": {
    "mnemosyne": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix", "shell",
        "nixpkgs#python3",
        "nixpkgs#python313Packages.pipx",
        "-c",
        "bash -c 'export PATH=\"$HOME/.local/bin:$PATH\" && pipx install --quiet mnemosyne-memory[mcp] mnemosyne-hermes 2>/dev/null; exec mnemosyne mcp'"
      ]
    },
    "nixos": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "github:utensils/mcp-nixos",
        "-c",
        "mcp-nixos"
      ]
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "context7": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ]
    }
  }
}
