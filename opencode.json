{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "NOTES/": "ask",
    "bash": {
      "git commit *": "ask",
      "grep *": "allow"
    },
    "edit": {
   	  "*" : "ask"
    }
  },
  "lsp": {},
  "mcp": {
    "nixos": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "github:utensils/mcp-nixos",
        "-c",
        "mcp-nixos"
      ]
    },
    "github": {
      "type": "local",
      "enabled": true,
      "command": [
        "nix",
        "shell",
        "nixpkgs#nodejs",
        "-c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    }
  }

}
