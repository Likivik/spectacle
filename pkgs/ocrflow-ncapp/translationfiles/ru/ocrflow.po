msgid "Send to OCR"
msgstr "Отправить на OCR"

msgid "Re-OCR anyway"
msgstr "Пересобрать OCR (принудительно)"

msgid "Scan folder (OCR)"
msgstr "Отсканировать папку (OCR)"

#. TRANSLATORS: the singular/plural is keyed off the number of queued files
msgid "File sent for OCR"
msgstr "Файл отправлен на OCR"

msgid "%n files sent for OCR"
msgstr "%n файлов отправлено на OCR"

msgid "File sent for re-OCR"
msgstr "Файл отправлен на повторный OCR"

msgid "%n files sent for re-OCR"
msgstr "%n файлов отправлено на повторный OCR"

msgid "OCR: %s sent, %s failed"
msgstr "OCR: отправлено %s, ошибок %s"

msgid "Could not send for OCR"
msgstr "Не удалось отправить на OCR"

msgid "Folder scan failed: %s"
msgstr "Ошибка сканирования папки: %s"

msgid "Folder queued for OCR: %s added, %s skipped (already OCR)"
msgstr "Папка отправлена на OCR: добавлено %s, пропущено (уже OCR) %s"

msgid "Could not scan folder"
msgstr "Не удалось отсканировать папку"
